    "productPathPattern": "^/[a-z0-9-]+/p/\\d+",
    "note": ""
  },
  "etos": {
    "name": "Etos",
    "site": "https://www.etos.nl",
    "enabled": true,
    "delayMs": 3000,
    "searchUrl": "https://www.etos.nl/search?q={q}",
    "productPathPattern": "/p/\\d+",
    "note": ""
  },
  "bol": {
    "name": "bol",
    "site": "https://www.bol.com",
    "enabled": true,
    "delayMs": 4000,
    "searchUrl": "https://www.bol.com/nl/nl/s/?searchtext={q}",
    "productPathPattern": "^/nl/nl/p/[^/]+/\\d+",
    "note": "bol heeft een partnerprogramma met een officiele product-API. Gebruik die feed zodra je een partner-account hebt; HTML-scrapen is de terugvaloptie."
  },
  "babypark": {
    "name": "Babypark",
    "site": "https://www.babypark.nl",
    "enabled": true,
    "delayMs": 3000,
    "searchUrl": "https://www.babypark.nl/catalogsearch/result/?q={q}",
    "productPathPattern": "\\.html$",
    "note": ""
  },
  "ah": {
    "name": "Albert Heijn",
    "site": "https://www.ah.nl",
    "enabled": false,
    "delayMs": 5000,
    "searchUrl": "https://www.ah.nl/zoeken?query={q}",
    "productPathPattern": "^/producten/product/wi\\d+",
    "note": "Standaard uitgezet: ah.nl weert geautomatiseerd verkeer actief. Zet pas aan als je hier afspraken over hebt."
  },
  "jumbo": {
    "name": "Jumbo",
    "site": "https://www.jumbo.com",
    "enabled": false,
    "delayMs": 5000,
    "searchUrl": "https://www.jumbo.com/zoeken?searchTerms={q}",
    "productPathPattern": "^/producten/",
    "note": "Standaard uitgezet: jumbo.com weert geautomatiseerd verkeer actief. Zet pas aan als je hier afspraken over hebt."
  }
